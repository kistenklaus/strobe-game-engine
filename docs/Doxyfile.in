# This file is configured by docs/CMakeLists.txt.  Keep documentation-specific
# Doxygen policy here; project paths are supplied by CMake.

PROJECT_NAME           = "@STROBE_DOCS_TITLE@"
OUTPUT_DIRECTORY       = "@STROBE_DOCS_DOXYGEN_OUTPUT@"
CREATE_SUBDIRS         = NO

INPUT                  = @STROBE_DOCS_DOXYGEN_INPUTS_DOXYFILE@
RECURSIVE              = YES
FILE_PATTERNS          = *.h *.hh *.hpp *.hxx *.c *.cc *.cpp *.cxx *.inl *.dox
EXCLUDE_PATTERNS       = */build/* */docs/*

EXTRACT_ALL            = NO
EXTRACT_PRIVATE         = NO
EXTRACT_STATIC          = YES
HIDE_UNDOC_MEMBERS      = YES
HIDE_UNDOC_CLASSES      = YES
SORT_MEMBER_DOCS       = NO
JAVADOC_AUTOBRIEF      = YES
MARKDOWN_SUPPORT        = YES

GENERATE_HTML          = NO
GENERATE_MAN           = NO
GENERATE_RTF           = NO
GENERATE_XML           = NO
GENERATE_LATEX         = YES
LATEX_OUTPUT           = latex
PDF_HYPERLINKS         = YES
USE_PDFLATEX           = NO

QUIET                  = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_AS_ERROR          = NO

INLINE_GROUPED_CLASSES = YES
