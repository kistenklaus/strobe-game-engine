<?xml version="1.0" encoding="UTF-8"?>

<doxygenlayout version="2.0">

  <!-- Group/topic pages -->
  <group>
    <briefdescription visible="no"/>

    <!-- Markdown content appears under this heading. -->
    <detaileddescription
        visible="yes"
        title="Overview"/>

    <groupgraph visible="no"/>

    <memberdecl>
      <!-- A single space suppresses Doxygen's default "Topics" title. -->
      <nestedgroups visible="yes" title=" "/>

      <modules visible="no"/>
      <dirs visible="no"/>
      <files visible="no"/>
      <namespaces visible="no"/>
      <concepts visible="no"/>

      <classes visible="yes" title="Objects"/>
      <defines visible="no"/>
      <typedefs visible="yes" title="Types"/>
      <sequences visible="no"/>
      <dictionaries visible="no"/>
      <enums visible="yes" title="Types"/>
      <enumvalues visible="yes"/>
      <functions visible="yes"/>
      <variables visible="yes"/>

      <signals visible="no"/>
      <publicslots visible="no"/>
      <protectedslots visible="no"/>
      <privateslots visible="no"/>
      <events visible="no"/>
      <properties visible="no"/>
      <friends visible="no"/>
      <membergroups visible="no"/>
    </memberdecl>

    <memberdef>
      <pagedocs visible="yes"/>
      <inlineclasses visible="yes"/>

      <defines visible="no"/>
      <typedefs visible="yes"/>
      <sequences visible="no"/>
      <dictionaries visible="no"/>
      <enums visible="yes"/>
      <enumvalues visible="yes"/>
      <functions visible="yes"/>
      <variables visible="yes"/>

      <signals visible="no"/>
      <publicslots visible="no"/>
      <protectedslots visible="no"/>
      <privateslots visible="no"/>
      <events visible="no"/>
      <properties visible="no"/>
      <friends visible="no"/>
    </memberdef>

    <authorsection visible="no"/>
  </group>

  <!-- Class pages -->
  <class>
    <briefdescription visible="yes"/>
    <detaileddescription visible="yes" title="Overview"/>
    <includes visible="$SHOW_HEADERFILE"/>
    <inheritancegraph visible="no"/>
    <collaborationgraph visible="no"/>
    <usedfiles visible="no"/>
    <authorsection visible="no"/>
  </class>

  <!-- Namespace pages -->
  <namespace>
    <briefdescription visible="yes"/>
    <detaileddescription visible="yes" title="Overview"/>
    <authorsection visible="no"/>
  </namespace>

  <!-- File pages -->
  <file>
    <briefdescription visible="no"/>
    <detaileddescription visible="no"/>
    <includes visible="no"/>
    <includegraph visible="no"/>
    <includedbygraph visible="no"/>
    <sourcelink visible="no"/>
    <memberdecl visible="no"/>
    <memberdef visible="no"/>
    <authorsection visible="no"/>
  </file>

</doxygenlayout>
